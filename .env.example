# Copy to .env.local and fill in. Never commit the real values.
# On the host (Netlify/Vercel), set these in the dashboard's environment
# variables instead — .env.local is not deployed.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
# Gmail App Password (16 chars, requires 2FA) — not your account password.
SMTP_PASS=
SMTP_FROM="My portfolio <you@gmail.com>"

# Where contact-form submissions are delivered.
CONTACT_TO=you@gmail.com
